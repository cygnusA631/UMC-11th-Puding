{
  "info": {
    "name": "UMC Week06 Spring Boot 저장 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "01부터 순서대로 실행. 01 재실행 시 새 실습 회원을 생성하고 ID 변수를 갱신합니다. DB 제약 우회 재현은 통합 테스트 결과를 참고하세요."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "runTag",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "otherMemberId",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 회원가입 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runTag', String(Date.now()).slice(-8));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('memberId', pm.response.json().result.memberId); pm.test('No password', () => pm.expect(pm.response.json().result).not.to.have.property('password'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"capture6_{{runTag}}@example.com\",\n  \"password\": \"Umc!1234\",\n  \"nickname\": \"푸딩{{runTag}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
