    {
      "name": "CORS 허용 Origin preflight",
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "http://localhost:5173"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "GET"
          }
        ],
        "url": "{{baseUrl}}/members/1/ratings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"CORS allowed\", function () { pm.response.to.have.status(200); pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:5173\"); });"
            ]
          }
        }
      ]
    }
  ]
