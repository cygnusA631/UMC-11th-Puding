{
  "info": {
    "name": "UMC Week05 Spring Boot 영화 평점 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "닉네임 중복",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/members/nickname/수현"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.response.json(); });"
            ]
          }
        }
      ]
    },
